          "customOutputs": [],
          "entries": [
            {
              "objID": "4a3cfb2b-b557-4f10-8973-d759dd1dca03",
              "variable": "screen_index",
              "value": "(screen_index < MAX_INDEX_OF_SCREEN) ? screen_index + 1 : 0"
            }
