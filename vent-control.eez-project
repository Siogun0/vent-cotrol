              "objID": "40bdd5d8-7043-4188-fde4-b704c5ee7d86",
              "variable": "screen_index",
              "value": "(screen_index > 0) ? screen_index - 1 : MAX_INDEX_OF_SCREEN"
            }
          ]
        },
        {
          "objID": "8753aac3-9d7a-46ca-9ebb-7c97eb429efd",
          "type": "SetVariableActionComponent",
          "left": -76,
